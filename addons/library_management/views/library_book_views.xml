<odoo>

    <!-- Form view: what you see when you open/edit ONE book -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="isbn"/>
                        <field name="total_copies"/>
                        <field name="available_copies"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view: the table showing ALL books -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="author"/>
                <field name="available_copies"/>
                <field name="total_copies"/>
            </tree>
        </field>
    </record>

    <!-- Action: tells Odoo "when this is clicked, show library.book records" -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu: the actual clickable item in the sidebar/app switcher -->
    <menuitem id="menu_library_root" name="Library"/>
    <menuitem id="menu_library_book" name="Books" parent="menu_library_root" action="action_library_book"/>

</odoo>